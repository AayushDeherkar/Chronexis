PORT=4000

# MongoDB Atlas — include the db name in the URI path
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/cognitive-twin?retryWrites=true&w=majority
MONGODB_DB_NAME=cognitive-twin

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:3000
